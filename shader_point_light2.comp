						hit_t = trace_scene_hit(pos,ray);

						if(hit_t > distance)
						{
							intensity +=  (1.0 - (distance / params.lightradius));
						}
						divisor += 1;
					}

					pos = uv_to_vec3( vec2( (float(ipos.x)+1.0) / params.lm_width, (float(ipos.y)+1.0) / params.lm_height) );

					if(is_point_on_triangle(pos))
					{
						pos += Normal* 0.1;
