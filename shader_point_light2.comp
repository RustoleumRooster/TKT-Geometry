					pos = uv_to_vec3( vec2( (float(ipos.x)+1.0) / params.lm_width, (float(ipos.y)+0.0) / params.lm_height) );

					if(is_point_on_triangle(pos))
					{
						pos += Normal* 0.1;
						ray = params.eye_pos - pos;
						distance = length(ray);
