#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_atomic_float : enable

//=====================================================================
// Sunlight
//
// One workgroup per triangle, scanning its texels like shader_arealight.comp.
// For each texel every thread picks a random point in the texel and a random
// direction inside the sun's cone, and traces it. A ray is lit if its closest
// hit is a sky triangle (GPU_TRIS_SKY in the BVH packing), or if it escapes
// the level and params.miss_is_sky is set.
//
//		texel = intensity * mean( visible * cos(ray, surface normal) )
//
// BVH leaf packing (see gpu_triangle_lists.h):
//		padding.x : prim 0 triangle no  | lightmap no << 16
//		padding.y : prim 0 material grp | gpu list    << 16
//		padding.z : prim 1 triangle no  | lightmap no << 16
//		padding.w : prim 1 material grp | gpu list    << 16
//

#define GPU_TRIS_SKY	1
#define NO_HIT			0xFFFFFFFF
#define MISS_DISTANCE	0xFFFF

struct Node
{
	vec4 aabbMin;
	vec4 aabbMax;

	vec4 padding;

	uint left_node;
	uint right_node;

	uint first_prim;
	uint n_prims;
};

//must match Sunlight_Module::SunTraceInfo
layout (binding = 0) uniform sunTraceParams
{
	vec3 sun_dir;		//toward the sun
	float cos_max;		//cos of the cone half angle

	vec3 sun_tan;
	float intensity;

	vec3 sun_bitan;
	uint n_passes;

	uint n_triangles;
	uint n_vertices;
	uint n_nodes;
	uint m_triangles_vertex_offset;

	uint m_triangles_index_offset;
	uint m_triangles_n_indices;

	uint lm_width;
	uint lm_height;

	uint miss_is_sky;
	uint seed;

	//single triangle debugging, see "Debug output" below
	uint debug_mode;
	float min_coverage;	//a texel is written when more than this fraction of its samples land on the triangle
	vec3 in_coords;		//lightmap uv of the clicked point (debug mode 1)
	float debug_ray_len;	//debug mode 1: length of rays drawn toward the sky
} params;

layout(std140, binding = 1) readonly buffer indexUBO
{
	uint global_indices[];
};

layout(std140, binding = 2) readonly buffer vertUBO
{
	vec3 global_vertices[];
};

layout(std140, binding = 3) readonly buffer uvUBO
{
	vec3 map_uvs[];
};

layout(std140, binding = 4) readonly buffer nodeUBO
{
	Node global_nodes[];
};

layout(std140, binding = 5) readonly buffer edgesUBO
{
	uint global_edges[];
};

layout(binding = 6, rgba8) uniform image2D imageOut;

//==================================================
// Debug output (Geometry_Module scratchpad, 512 vec3)
//
// Only written when params.debug_mode != 0, and the host only sets that on a
// single workgroup dispatch of the selected triangle.
//
// debug_mode 1 (rays of the clicked texel):
//		hits[t]       = sample position of thread t (last pass)
//		hits[256 + t] = end of its ray: the hit point, or a fixed length on the way to the sky
//		hits[0..255] are left zero for threads with no valid sample
//		nothing else, so hits[t] == hits[256 + t] == 0 means "no sample"
//
// debug_mode 2 (texels visited by the rasteriser):
//		hits[0]       = (texels visited, uv_degenerate, rows walked)
//		hits[1 + k]   = (texel x, texel y, valid sample count)    k < 255
//		hits[257 + k] = world position of the texel centre (extrapolated off the triangle if need be)
//		hits[256]     = (written count, 0, 0)
//

#define DEBUG_RAYS		1
#define DEBUG_TEXELS	2

layout(std140, binding = 7) buffer hitResults
{
	vec3 hits[];
};

//==================================================
// Random numbers (Tiny Encryption Algorithm)
//

uint[2] tea(uint v[2])
{
	uint v0 = v[0];
	uint v1 = v[1];
	uint delta = 0x9E3779B9;
	uint k0 = 0xA341316C;
	uint k1 = 0xC8013EA4;
	uint k2 = 0xAD90777D;
	uint k3 = 0x7E95761E;
	uint sum = 0;

	for(int i=0;i<6;i++)
	{
		sum+=delta;
		v0+= ((v1<<4) + k0) ^ (v1+sum) ^ ((v1>>5) + k1);
		v1+= ((v0<<4) + k2) ^ (v0+sum) ^ ((v0>>5) + k3);
	}

	return uint[2](v0,v1);
}

float random_to_float01(uint random)
{
	uint u = random >> 9 | 0x3F800000;
	return uintBitsToFloat(u) - 1.0;
}

//==================================================
// Sun cone sampling
//
// Uniform over the solid angle of the cone: cos(theta) uniform in [cos_max, 1]
//

vec3 rand_sun_ray(inout uint seed)
{
	uint[2] V = tea(uint[2](seed,0));
	seed = V[1];

	float cos_t = 1.0 - random_to_float01(V[0]) * (1.0 - params.cos_max);
	float sin_t = sqrt(max(0.0, 1.0 - cos_t*cos_t));
	float phi = random_to_float01(V[1]) * 3.1415926535 * 2.0;

	vec3 ray = params.sun_tan * (sin_t * cos(phi)) +
			   params.sun_bitan * (sin_t * sin(phi)) +
			   params.sun_dir * cos_t;

	return normalize(ray);
}

//==================================================
// Global functions
//

float trace_node_triangles_hit(in uint node_i, in vec3 eye, in vec3 ray, out uint hit_id, out uint hit_list)
{
	vec3 edge1, edge2, rayVecXe2, s, sXe1;
	float det, invDet, u, v;

	float best = MISS_DISTANCE;
	hit_id = NO_HIT;
	hit_list = NO_HIT;

	for(uint j = 0; j < global_nodes[node_i].n_prims; j++)
	{
		uint idx;
		uint list;

		if(j==0)
		{
			idx  = floatBitsToUint(global_nodes[node_i].padding.x) & 0xFFFF;
			list = (floatBitsToUint(global_nodes[node_i].padding.y) >> 16) & 0xFFFF;
		}
		else
		{
			idx  = floatBitsToUint(global_nodes[node_i].padding.z) & 0xFFFF;
			list = (floatBitsToUint(global_nodes[node_i].padding.w) >> 16) & 0xFFFF;
		}

		edge1 = global_vertices[global_indices[(idx*3) + 1]] - global_vertices[global_indices[idx*3]];
		edge2 = global_vertices[global_indices[(idx*3) + 2]] - global_vertices[global_indices[idx*3]];
		rayVecXe2 = cross(ray,edge2);
		det = dot(edge1,rayVecXe2);

		//one sided: only surfaces facing the ray
		if(det < 0.00001)
			continue;

		invDet = 1.0 / det;
		s = eye - global_vertices[global_indices[idx*3]];
		u = invDet * dot(s,rayVecXe2);

		if( u < 0.0 || u > 1.0)
			continue;

		sXe1 = cross(s,edge1);
		v = invDet * dot(ray,sXe1);

		if(v < 0.0 || u+v > 1.0)
			continue;

		float t = invDet * dot(edge2,sXe1);

		if(t > 0 && t < best)
		{
			best = t;
			hit_id = idx;
			hit_list = list;
		}
	}

	return best;
}

float trace_node_hit(in uint node_i, in vec3 eye, in vec3 ray)
{
	Node node = global_nodes[node_i];
	float dif;
	float t;
	float best = MISS_DISTANCE;
	vec3 hit;

	if(eye.x < node.aabbMax.x + 0.001 && eye.x > node.aabbMin.x - 0.001 &&
		eye.y < node.aabbMax.y + 0.001 && eye.y > node.aabbMin.y - 0.001 &&
		eye.z < node.aabbMax.z + 0.001 && eye.z > node.aabbMin.z - 0.001 )
	{
		return 0;
	}

	//X MIN PLANE
	dif = node.aabbMin.x - eye.x;
	t = dif / ray.x;
	hit = eye + ray*t;

	if(t > 0 && hit.y > node.aabbMin.y && hit.y < node.aabbMax.y && hit.z > node.aabbMin.z && hit.z < node.aabbMax.z && t < best)
		best = t;

	//X MAX PLANE
	dif = node.aabbMax.x - eye.x;
	t = dif / ray.x;
	hit = eye + ray*t;

	if(t > 0 && hit.y > node.aabbMin.y && hit.y < node.aabbMax.y && hit.z > node.aabbMin.z && hit.z < node.aabbMax.z && t < best)
		best = t;

	//Y MIN PLANE
	dif = node.aabbMin.y - eye.y;
	t = dif / ray.y;
	hit = eye + ray*t;

	if(t > 0 && hit.x > node.aabbMin.x && hit.x < node.aabbMax.x && hit.z > node.aabbMin.z && hit.z < node.aabbMax.z && t < best)
		best = t;

	//Y MAX PLANE
	dif = node.aabbMax.y - eye.y;
	t = dif / ray.y;
	hit = eye + ray*t;

	if(t > 0 && hit.x > node.aabbMin.x && hit.x < node.aabbMax.x && hit.z > node.aabbMin.z && hit.z < node.aabbMax.z && t < best)
		best = t;

	//Z MIN PLANE
	dif = node.aabbMin.z - eye.z;
	t = dif / ray.z;
	hit = eye + ray*t;

	if(t > 0 && hit.x > node.aabbMin.x && hit.x < node.aabbMax.x && hit.y > node.aabbMin.y && hit.y < node.aabbMax.y && t < best)
		best = t;

	//Z MAX PLANE
	dif = node.aabbMax.z - eye.z;
	t = dif / ray.z;
	hit = eye + ray*t;

	if(t > 0 && hit.x > node.aabbMin.x && hit.x < node.aabbMax.x && hit.y > node.aabbMin.y && hit.y < node.aabbMax.y && t < best)
		best = t;

	return best;
}

uint indexed(uint v_i)
{
	return global_indices[v_i];
}

uint indexed(uint v_i, uint offset)
{
	return global_indices[v_i+offset];
}

//==================================================
// Private variables
//

uint[12] stack;
float[12] stack_distance;
uint stack_n;

//==================================================
// Functions that use private variables
//

void open_node(uint node_i, vec3 eye, vec3 ray)
{
	float left,right;

	left = trace_node_hit(global_nodes[node_i].left_node,eye,ray);

	right = trace_node_hit(global_nodes[node_i].right_node,eye,ray);

	if(left < MISS_DISTANCE && right < MISS_DISTANCE)
	{
		if(left < right)
		{
			stack[stack_n] = global_nodes[node_i].right_node;
			stack_distance[stack_n] = right;

			stack[stack_n+1] = global_nodes[node_i].left_node;
			stack_distance[stack_n+1] = left;
		}
		else
		{
			stack[stack_n] = global_nodes[node_i].left_node;
			stack_distance[stack_n] = left;

			stack[stack_n+1] = global_nodes[node_i].right_node;
			stack_distance[stack_n+1] = right;
		}

		stack_n += 2;
	}
	else if(left < MISS_DISTANCE)
	{
		stack[stack_n] = global_nodes[node_i].left_node;
		stack_distance[stack_n] = left;

		stack_n += 1;
	}
	else if(right < MISS_DISTANCE)
	{
		stack[stack_n] = global_nodes[node_i].right_node;
		stack_distance[stack_n] = right;

		stack_n += 1;
	}
}

//closest hit; hit_list is the gpu triangle list of the hit triangle, or NO_HIT on a miss
float trace_scene_hit(vec3 eye, vec3 ray, out uint hit_list)
{
	stack_n=0;
	float best = MISS_DISTANCE;
	hit_list = NO_HIT;

	if(trace_node_hit(0,eye,ray) < MISS_DISTANCE)
	{
		open_node(0,eye,ray);

		while(stack_n > 0)
		{
			stack_n -= 1;

			if(global_nodes[stack[stack_n]].n_prims > 0)
			{
				uint id, list;
				float t = trace_node_triangles_hit(stack[stack_n],eye,ray,id,list);

				if(t < best)
				{
					best = t;
					hit_list = list;
				}
			}
			else if(stack_distance[stack_n] < best)
			{
				open_node(stack[stack_n],eye,ray);
			}
		}
	}

	return best;
}

bool ray_reaches_sky(vec3 eye, vec3 ray, out float d)
{
	uint hit_list;
	d = trace_scene_hit(eye, ray, hit_list);

	if(hit_list == NO_HIT)
		return params.miss_is_sky != 0;

	return hit_list == GPU_TRIS_SKY;
}

//==================================================
// Layout
//

layout (local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

//==================================================
// Shared variables
//

shared float m0,m1,m2;
shared bool b0,b1,bNegativeX;
shared uint i_0;
shared uint v_0,v_1,v_2;
shared vec2 w0,w1,w2;		//uvs snapped to texel centres: only used to walk the rows
shared vec2 uv0,uv1,uv2;	//true uvs: used for sample placement
shared float inv_uv_det;
shared bool uv_degenerate;
shared float y0;
shared vec3 Normal;
shared uint x0,x1;
shared uint edges[3];
shared vec3 EdgeNormal0,EdgeNormal1,EdgeNormal2;
shared float shared_total;
shared float ray_count;
shared uint point_type;
shared uint debug_n_texels;
shared uint debug_n_written;
shared uint debug_n_rows;

//==================================================
// Functions that use shared variables
//

//Barycentric coords of a lightmap uv against the triangle's true uvs.
//Working in uv space keeps the test independent of world scale and of
//how thin the triangle is.
vec3 uv_barycentric(vec2 uv)
{
	vec2 d = uv1 - uv0;
	vec2 e = uv2 - uv0;
	vec2 f = uv  - uv0;

	float b1 = (f.x * e.y - f.y * e.x) * inv_uv_det;
	float b2 = (d.x * f.y - d.y * f.x) * inv_uv_det;

	return vec3(1.0 - b1 - b2, b1, b2);
}

#define BARY_EPS 0.0001

bool uv_inside(vec2 uv)
{
	if(uv_degenerate)
		return false;

	vec3 b = uv_barycentric(uv);
	return b.x >= -BARY_EPS && b.y >= -BARY_EPS && b.z >= -BARY_EPS;
}

//World position of a lightmap uv; always exactly on the triangle's plane.
//Returns whether the uv lies on the triangle.
bool uv_to_world(vec2 uv, out vec3 pos)
{
	vec3 b = uv_barycentric(uv);

	pos = b.x * global_vertices[v_0] +
		  b.y * global_vertices[v_1] +
		  b.z * global_vertices[v_2];

	return !uv_degenerate && b.x >= -BARY_EPS && b.y >= -BARY_EPS && b.z >= -BARY_EPS;
}

bool is_on_edge(vec3 P, uint v0, uint v1)
{
	return (length(P-global_vertices[indexed(i_0,v0)]) +
			length(P-global_vertices[indexed(i_0,v1)]) -
			length(global_vertices[indexed(i_0,v1)] - global_vertices[indexed(i_0,v0)]) < 0.05);
}

//At a concave edge the ray must also leave in front of the adjacent triangle,
//otherwise it would start "inside" the neighbouring surface
bool edges_allow_ray(vec3 P, vec3 ray)
{
	if(edges[0] != 0xFFFF && is_on_edge(P,1,0) && dot(ray,EdgeNormal0) <= 0)
		return false;

	if(edges[1] != 0xFFFF && is_on_edge(P,1,2) && dot(ray,EdgeNormal1) <= 0)
		return false;

	if(edges[2] != 0xFFFF && is_on_edge(P,2,0) && dot(ray,EdgeNormal2) <= 0)
		return false;

	return true;
}

float floor_y_value(float y)
{
	return (floor(params.lm_height * y)+0.5) / params.lm_height;
}

float floor_x_value(float x)
{
	return (floor(params.lm_width * x)+0.5) / params.lm_width;
}

float MajorX(float y)
{
	return w0.x + (m0 * (y - w0.y));
}

float MinorX(float y)
{
	if(b0 && b1)
	{
		if(bNegativeX)
		{
			return max(w0.x + (m1 * (y - w0.y)), w2.x + (m2 * (y - w2.y)));
		}
		else
		{
			return min(w0.x + (m1 * (y - w0.y)), w2.x + (m2 * (y - w2.y)));
		}
	}
	else if(b0)
	{
		return w0.x + (m1 * (y - w0.y));
	}
	else if(b1)
	{
		return w2.x + (m2 * (y - w2.y));
	}
	return 0;
}

void main()
{
	uint ix = gl_LocalInvocationID.x;
	uint iy = gl_LocalInvocationID.y;
	uint thread_id = iy * gl_WorkGroupSize.x + ix;

	if(gl_WorkGroupID.x * 3 < params.m_triangles_n_indices && ix == 0 && iy == 0)
	{
		//========================================================
		// Assign the vertex in order of increasing y in uv coords
		// v0 = least y     v1 = greatest y     v2 = in between
		//
		// v0 -> v1 is the major axis
		// v0 -> v2 and v2 -> v1 are the minor axis
		//
		//					* v0
		//
		//				* v2
		//				          * v1

		i_0 = params.m_triangles_index_offset + gl_WorkGroupID.x*3;

		if(map_uvs[indexed(i_0)].y < map_uvs[indexed(i_0,1)].y)
			v_0 = 0;
		else
			v_0 = 1;

		if(map_uvs[indexed(i_0,v_0)].y < map_uvs[indexed(i_0,2)].y)
			v_0 = v_0;
		else
			v_0 = 2;

		if(map_uvs[indexed(i_0,((v_0+1)%3))].y > map_uvs[indexed(i_0,((v_0+2)%3))].y)
		{
			v_1 = (v_0+1)%3;
			v_2 = (v_0+2)%3;
		}
		else
		{
			v_1 = (v_0+2)%3;
			v_2 = (v_0+1)%3;
		}

		v_0 = indexed(i_0,v_0);
		v_1 = indexed(i_0,v_1);
		v_2 = indexed(i_0,v_2);

		uv0 = map_uvs[v_0].xy;
		uv1 = map_uvs[v_1].xy;
		uv2 = map_uvs[v_2].xy;

		w0 = vec2(floor_x_value(uv0.x),floor_y_value(uv0.y));
		w1 = vec2(floor_x_value(uv1.x),floor_y_value(uv1.y));
		w2 = vec2(floor_x_value(uv2.x),floor_y_value(uv2.y));

		//rows are decided on the snapped uvs, so the row tests and the slopes agree
		float half_row = 0.5 / params.lm_height;

		b0 = w2.y > w0.y + half_row;
		b1 = w1.y > w2.y + half_row;

		m0 = (w1.y > w0.y + half_row) ? (w1.x - w0.x) / (w1.y - w0.y) : 0.0;
		m1 = b0 ? (w2.x - w0.x) / (w2.y - w0.y) : 0.0;
		m2 = b1 ? (w1.x - w2.x) / (w1.y - w2.y) : 0.0;

		bNegativeX = false;

		if(MajorX(w2.y) > w2.x)
			bNegativeX = true;

		//==================================================
		// UV -> world goes through barycentrics of the true uvs
		//

		float uv_det = (uv1.x - uv0.x) * (uv2.y - uv0.y) - (uv1.y - uv0.y) * (uv2.x - uv0.x);

		uv_degenerate = abs(uv_det) < 1e-12;
		inv_uv_det = uv_degenerate ? 0.0 : 1.0 / uv_det;

		Normal = cross(global_vertices[indexed(i_0,1)] - global_vertices[indexed(i_0,0)], global_vertices[indexed(i_0,2)] - global_vertices[indexed(i_0,1)]);
		Normal = normalize(Normal);

		//=============================
		// Edges
		//

		edges[0] = global_edges[i_0+0];
		edges[1] = global_edges[i_0+1];
		edges[2] = global_edges[i_0+2];

		if(edges[0] != 0xFFFF)
		{
			uint t0 = global_edges[i_0+0] * 3;
			EdgeNormal0 = cross(global_vertices[indexed(t0,1)] - global_vertices[indexed(t0,0)], global_vertices[indexed(t0,2)] - global_vertices[indexed(t0,1)]);
		}

		if(edges[1] != 0xFFFF)
		{
			uint t0 = global_edges[i_0+1] * 3;
			EdgeNormal1 = cross(global_vertices[indexed(t0,1)] - global_vertices[indexed(t0,0)], global_vertices[indexed(t0,2)] - global_vertices[indexed(t0,1)]);
		}

		if(edges[2] != 0xFFFF)
		{
			uint t0 = global_edges[i_0+2] * 3;
			EdgeNormal2 = cross(global_vertices[indexed(t0,1)] - global_vertices[indexed(t0,0)], global_vertices[indexed(t0,2)] - global_vertices[indexed(t0,1)]);
		}
	}

	//different stream per thread and per triangle
	uint rand_state = tea(uint[2](thread_id, gl_WorkGroupID.x ^ params.seed))[0];
	float ystep = 1.0 / params.lm_height;

	//clicked texel, for DEBUG_RAYS
	ivec2 debug_texel = ivec2(floor(params.in_coords.x * params.lm_width), floor(params.in_coords.y * params.lm_height));

	if(params.debug_mode != 0)
	{
		hits[thread_id] = vec3(0);
		hits[thread_id + 256] = vec3(0);
	}

	//========================================================
	// Main loop
	//

	memoryBarrierBuffer();
	barrier();

	if(ix == 0 && iy == 0)
	{
		y0 = w0.y;
		debug_n_texels = 0;
		debug_n_written = 0;
		debug_n_rows = 0;
	}

	barrier();

	while(y0 < w1.y + 0.001)
	{
		barrier();

		if(ix == 0 && iy == 0)
		{
			if(!b0 && !b1)
			{
				//whole triangle sits in one texel row
				x0 = uint(params.lm_width * min(w0.x, min(w1.x, w2.x)));
				x1 = uint(params.lm_width * max(w0.x, max(w1.x, w2.x)));
			}
			else if(bNegativeX==false)
			{
				x0 = uint(params.lm_width * MajorX(y0));
				x1 = uint(params.lm_width * MinorX(y0));
			}
			else
			{
				x0 = uint(params.lm_width * MinorX(y0));
				x1 = uint(params.lm_width * MajorX(y0));
			}
		}

		barrier();

		int i=0;

		while(x0 + i <= x1)
		{
			ivec2 ipos = ivec2(x0 + i, uint(params.lm_height * y0));

			barrier();

			if(ix == 0 && iy == 0)
			{
				shared_total = 0;
				ray_count = 0;
				point_type = 0;

				//====================================
				// If no corner of the texel is off of the triangle we can treat it differently (faster)
				//

				vec2 texel_lo = vec2(float(ipos.x) / params.lm_width, float(ipos.y) / params.lm_height);
				vec2 texel_hi = vec2((float(ipos.x) + 1.0) / params.lm_width, (float(ipos.y) + 1.0) / params.lm_height);

				if(uv_inside(texel_lo) &&
				   uv_inside(vec2(texel_hi.x, texel_lo.y)) &&
				   uv_inside(vec2(texel_lo.x, texel_hi.y)) &&
				   uv_inside(texel_hi))
				{
					point_type = 1;
				}
			}

			barrier();

			for(uint pass = 0; pass < params.n_passes; pass++)
			{
				//====================================
				// Randomly select a point in the texel (on the triangle)
				//

				bool valid_pos = point_type == 1;

				uint[2] V = tea(uint[2](rand_state,0));
				rand_state = V[1];

				vec3 pos;
				bool inside = uv_to_world( vec2( (float(ipos.x) + random_to_float01(V[0])) / params.lm_width,
												 (float(ipos.y) + random_to_float01(V[1])) / params.lm_height), pos);

				if(!valid_pos)
				{
					valid_pos = inside;

					int k=0;
					while(!valid_pos && k < 8)
					{
						V = tea(uint[2](rand_state,0));
						rand_state = V[1];
						valid_pos = uv_to_world( vec2( (float(ipos.x) + random_to_float01(V[0])) / params.lm_width,
													   (float(ipos.y) + random_to_float01(V[1])) / params.lm_height), pos);
						k++;
					}
				}

				//====================================
				// Random direction in the sun's cone
				//

				vec3 ray = rand_sun_ray(rand_state);
				float cos_n = dot(ray,Normal);

				float contribution = 0;

				float d = 0;
				bool traced = false;
				bool lit = false;

				if(valid_pos && cos_n > 0 && (point_type == 1 || edges_allow_ray(pos,ray)))
				{
					traced = true;
					lit = ray_reaches_sky(pos,ray,d);

					if(lit)
						contribution = cos_n;
				}

				if(params.debug_mode == DEBUG_RAYS && ipos == debug_texel && valid_pos)
				{
					//traced rays end at their hit (or params.debug_ray_len toward the sky);
					//rejected rays (back facing / blocked by an edge) are a short stub
					float len = traced ? (lit || d >= MISS_DISTANCE ? params.debug_ray_len : d) : params.debug_ray_len * 0.125;
					hits[thread_id] = pos;
					hits[thread_id + 256] = pos + ray * len;
				}

				//============================================
				// Add up the contribution from each thread in the subgroup, then each subgroup
				//

				subgroupBarrier();

				float subgroup_total = subgroupAdd(contribution);
				float subgroup_count = subgroupAdd(valid_pos ? 1.0 : 0.0);

				if(subgroupElect())
				{
					atomicAdd(shared_total,subgroup_total);
					atomicAdd(ray_count,subgroup_count);
				}

				barrier();
			}

			if(ix == 0 && iy == 0)
			{
				//too few samples landed on the triangle to trust (texel barely touches it)
				bool written = ray_count > params.min_coverage * 256.0 * params.n_passes;

				if(written)
				{
					float p = params.intensity * shared_total / ray_count;
					imageStore(imageOut,ipos,vec4(p,1,p,1));
				}

				if(params.debug_mode == DEBUG_TEXELS)
				{
					if(debug_n_texels < 255)
					{
						vec3 centre;
						uv_to_world(vec2((float(ipos.x) + 0.5) / params.lm_width, (float(ipos.y) + 0.5) / params.lm_height), centre);

						hits[1 + debug_n_texels] = vec3(ipos.x, ipos.y, ray_count);
						hits[257 + debug_n_texels] = centre;
					}

					debug_n_texels++;
					if(written)
						debug_n_written++;
				}
			}

			barrier();

			i++;

		} //while(x0 + i <= x1)

		barrier();

		if(ix == 0 && iy == 0)
		{
			y0 += (ystep);
			debug_n_rows++;
		}

		barrier();
	} // main loop

	if(params.debug_mode == DEBUG_TEXELS && ix == 0 && iy == 0)
	{
		hits[0] = vec3(debug_n_texels, uv_degenerate ? 1.0 : 0.0, debug_n_rows);
		hits[256] = vec3(debug_n_written, 0, 0);
	}

	return;
}
